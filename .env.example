# Penpot
PENPOT_BASE_URL=http://192.168.1.50:9001
PENPOT_EMAIL=your_penpot_email
PENPOT_PASSWORD=your_penpot_password
PENPOT_FILE_ID=your_penpot_file_id
PENPOT_ACCESS_TOKEN=your_penpot_access_token

# Table parsing / chat
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# AI image (APIMart)
AI_IMAGE_PROVIDER=auto
AI_IMAGE_BASE_URL=https://api.apimart.ai
AI_IMAGE_API_KEY=sk-your-apimart-key-here
AI_IMAGE_JOB_TIMEOUT_SECONDS=600
# Optional proxy used only to download completed provider result images.
AI_IMAGE_DOWNLOAD_PROXY_URL=

# BFL official FLUX outpainting. Disabled by default; both the flag and API key are required.
BFL_OUTPAINTING_ENABLED=false
BFL_API_KEY=
BFL_API_URL=https://api.bfl.ai
BFL_OUTPAINTING_MODE=fast
BFL_OUTPAINTING_OUTPUT_FORMAT=PNG
BFL_OUTPAINTING_AUTO_CROP=false
BFL_OUTPAINTING_MAX_CONCURRENCY=2
BFL_OUTPAINTING_MAX_QUEUE_SIZE=4
BFL_OUTPAINTING_MAX_PENDING_PER_USER=2
BFL_OUTPAINTING_MAX_REQUEST_BYTES=30000000
BFL_OUTPAINTING_TIMEOUT_SECONDS=600
BFL_OUTPAINTING_POLL_INTERVAL_SECONDS=2
BFL_OUTPAINTING_TRANSIENT_RETRIES=4
BFL_OUTPAINTING_RETRY_BACKOFF_SECONDS=1.5
BFL_OUTPAINTING_RETRY_BACKOFF_CAP_SECONDS=8
BFL_OUTPAINTING_RESULT_DOWNLOAD_RETRIES=2
BFL_OUTPAINTING_RESULT_HOST_SUFFIXES=delivery.bfl.ai,bfl.ai
BFL_OUTPAINTING_MAX_SOURCE_BYTES=20971520
BFL_OUTPAINTING_MAX_SOURCE_PIXELS=50000000
BFL_OUTPAINTING_MAX_ENCODED_INPUT_BYTES=20971520
BFL_OUTPAINTING_MAX_RESULT_BYTES=30000000
# Kept for compatibility; FLUX outpainting sends exact pixel margins.
OUTPAINT_SNAP_PIXELS=1
OUTPAINT_MAX_WIDTH=2048
OUTPAINT_MAX_HEIGHT=2048
OUTPAINT_MAX_AREA_PIXELS=4194304
OUTPAINT_RECOMMENDED_AREA_PIXELS=2097152

# AI image subscription line (CLIProxyAPI)
CLIPROXY_BASE_URL=
CLIPROXY_API_KEY=
# Optional per-provider proxy, for example http://127.0.0.1:7890
CLIPROXY_PROXY_URL=
# One real subscription image request per hour between 09:00 and 21:00.
SUB2API_MONITOR_ENABLED=true
SUB2API_MONITOR_TIMEZONE=Asia/Shanghai
SUB2API_MONITOR_TIMEOUT_SECONDS=600
SUB2API_MONITOR_RETENTION_DAYS=30

# AI image (adobe2api)
ADOBE2API_BASE_URL=http://77.73.8.142:6001/v1
ADOBE2API_API_KEY=

# Optional separate img2img provider config; leave empty to reuse AI_IMAGE_*.
NANO_BANANA_BASE_URL=
NANO_BANANA_API_KEY=

# VLM image analysis; leave BASE_URL / API_KEY empty to reuse AI_IMAGE_*.
VLM_MODEL=qwen2.5-vl-72b-instruct
VLM_BASE_URL=
VLM_API_KEY=

# Kie Seedream 5 Pro layer decomposition for "转 PSD". Leave the key empty to disable it.
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_API_KEY=
KIE_LAYER_MODEL=seedream/5-pro-layer-decomposition
KIE_LAYER_SIZE=auto
KIE_LAYER_OUTPUT_FORMAT=png
KIE_TIMEOUT_SECONDS=900
KIE_POLL_INTERVAL_SECONDS=3
KIE_INPUT_DOWNLOAD_RETRIES=1
KIE_RESULT_DOWNLOAD_RETRIES=1

# Proxy download relay (built into main backend)
PROXY_DOWNLOAD_ENABLED=false
PROXY_DOWNLOAD_TOKEN=change-me
PROXY_DOWNLOAD_ALLOWED_HOSTS=huaban.com,www.huaban.com
PROXY_DOWNLOAD_HEADLESS=false
PROXY_DOWNLOAD_BROWSER_CHANNEL=msedge
PROXY_DOWNLOAD_LOGIN_URL=https://huaban.com/
PROXY_DOWNLOAD_REQUEST_TIMEOUT_SECONDS=180
PROXY_DOWNLOAD_NAVIGATION_TIMEOUT_MS=30000

# Local upscale CLI. Required for the upscale feature. Windows example: G:\\AI\\gigapixel-beta.exe
UPSCALE_CLI_PATH=
UPSCALE_CLI_MODEL=
UPSCALE_CLI_SCALE=2
UPSCALE_CLI_TIMEOUT_SECONDS=900

# Codex-style agent skills. Use ; on Windows and : on macOS/Linux to separate paths.
AGENT_SKILL_PATHS=./skills

# Skill planner LLM. Leave BASE_URL / API_KEY empty to reuse CLIPROXY_* subscription line.
SKILL_LLM_MODEL=gpt-5.5
SKILL_LLM_BASE_URL=
SKILL_LLM_API_KEY=
SKILL_LLM_TIMEOUT_SECONDS=60

# Local paths
PRODUCT_LIBRARY_PATH=./product-library
OUTPUT_PATH=./output
LOGIN_USERS_PATH=./login_users.json
