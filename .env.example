# Penpot
PENPOT_BASE_URL=http://192.168.1.50:9001
PENPOT_EMAIL=your_penpot_email
PENPOT_PASSWORD=your_penpot_password
PENPOT_FILE_ID=your_penpot_file_id
PENPOT_ACCESS_TOKEN=your_penpot_access_token

# Table parsing / chat
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# AI image (APIMart)
AI_IMAGE_PROVIDER=apimart
AI_IMAGE_BASE_URL=https://api.apimart.ai
AI_IMAGE_API_KEY=sk-your-apimart-key-here

# AI image (ZenMux optional fallback line)
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_API_KEY=
ZENMUX_MANAGEMENT_API_KEY=
ZENMUX_GPT_IMAGE_MODEL=openai/gpt-image-2
ZENMUX_NANO_BANANA_MODEL=google/gemini-3-pro-image-preview

# Optional separate img2img provider config; leave empty to reuse AI_IMAGE_*.
NANO_BANANA_BASE_URL=
NANO_BANANA_API_KEY=

# VLM image analysis; leave BASE_URL / API_KEY empty to reuse AI_IMAGE_*.
VLM_MODEL=qwen2.5-vl-72b-instruct
VLM_BASE_URL=
VLM_API_KEY=

# Proxy download relay (built into main backend)
PROXY_DOWNLOAD_ENABLED=false
PROXY_DOWNLOAD_TOKEN=change-me
PROXY_DOWNLOAD_ALLOWED_HOSTS=huaban.com,www.huaban.com
PROXY_DOWNLOAD_HEADLESS=false
PROXY_DOWNLOAD_BROWSER_CHANNEL=msedge
PROXY_DOWNLOAD_LOGIN_URL=https://huaban.com/
PROXY_DOWNLOAD_REQUEST_TIMEOUT_SECONDS=180
PROXY_DOWNLOAD_NAVIGATION_TIMEOUT_MS=30000

# Local paths
PRODUCT_LIBRARY_PATH=./product-library
OUTPUT_PATH=./output
LOGIN_USERS_PATH=./login_users.json
