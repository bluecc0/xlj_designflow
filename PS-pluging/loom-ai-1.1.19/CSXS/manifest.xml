<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
  ExtensionBundleId="com.loom.ai.painter"
  ExtensionBundleVersion="2.0.0"
  ExtensionBundleName="Loom AI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.loom.ai.painter.panel" Version="2.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[0.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.loom.ai.painter.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/main.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-running-insecure-content</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Loom AI</Menu>
          <Geometry>
            <Size>
              <Width>220</Width>
              <Height>560</Height>
            </Size>
            <MinSize>
              <Width>220</Width>
              <Height>420</Height>
            </MinSize>
            <MaxSize>
              <Width>1600</Width>
              <Height>2000</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/loom-icon.png</Icon>
            <Icon Type="RollOver">./assets/loom-icon.png</Icon>
            <Icon Type="DarkNormal">./assets/loom-icon.png</Icon>
            <Icon Type="DarkRollOver">./assets/loom-icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
